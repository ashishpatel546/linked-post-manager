# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- LinkedIn developer app (developer.linkedin.com > your app > Auth) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match an "Authorized redirect URL" on the app's Auth tab, character for character.
# Locally this is the one-shot server `npm run auth` starts. On a deployment it
# is a route of the app itself — https://<your-app>/api/callback — and BOTH have
# to be registered on the Auth tab if you use both.
LINKEDIN_REDIRECT_URI=http://localhost:5599/callback

# ---- Targets ----
# Company page 109594354 -> urn:li:organization:109594354
LINKEDIN_ORGANIZATION_URN=urn:li:organization:109594354
# Cosmetic: the name shown as the author in the post preview when posting as
# the company. LinkedIn identifies the page by URN regardless of what this says.
LINKEDIN_ORGANIZATION_NAME=

# ---- API versioning ----
# LinkedIn versions the /rest/ API by month (YYYYMM) and supports roughly a year
# of versions. Bump this when LinkedIn deprecates it; the client surfaces the
# error clearly if it goes stale.
LINKEDIN_API_VERSION=202608

# ---- Guardrails ----
# Hard cap on posts published per calendar day, across both targets. The server
# refuses to publish past this, regardless of what it is asked to do.
LINKEDIN_DAILY_POST_LIMIT=5

# When true, publish tools ignore confirm:true and always return a preview.
# Useful while testing. Set to false only when you are ready to post for real.
LINKEDIN_FORCE_DRY_RUN=true

# ---- What to keep in storage ----
# Every write is recorded in the audit log. A dry run records that nothing was
# sent — informative while debugging, and on S3 one PUT per preview click.
LINKEDIN_AUDIT_DRY_RUNS=false

# What survives a publish.
#   stub — a few hundred bytes: topic, URN, when. Enough to list the post and
#          link straight to it. The markdown and the rendered deck are deleted,
#          because the post itself now lives on LinkedIn.
#   full — the whole record, prose and deck included. The only way to read your
#          own text back later: LinkedIn will not serve a personal post to the
#          API (r_member_social is a closed permission), and the audit entry
#          keeps 120 characters.
LINKEDIN_KEEP_PUBLISHED=stub

# Your site or profile page. When set, it is appended to every post and every
# article's commentary, and shown on the last page of an article deck.
# Leave empty to disable. Applied at publish time, so it is never stored in a
# draft and never duplicated if the body already contains the URL.
LINKEDIN_PROFILE_LINK=
LINKEDIN_PROFILE_LINK_LABEL=More:

# ---- Access control (deployments only) ----
# Who may sign in. Emails and/or member URNs, comma separated.
#
# Registering the LinkedIn app restricts nothing — it is an OAuth client, so any
# LinkedIn member can authorize it, the same way anyone can "Sign in with Google"
# to a third-party site. On a public URL this list is what stands between a
# stranger and your provider key, your app's LinkedIn rate limit, and your
# developer account's standing.
#
# Empty means NOBODY. A forgotten env var must not become an open door.
# A member URN is the stronger entry: an email can change hands, a URN cannot.
LINKEDIN_ALLOWED_MEMBERS=

# Require a signed-in member for every storage access.
# Off for the local single-user install. MUST be true on any deployment: without
# it, two people share one storage tree, the second sign-in overwrites the
# first's LinkedIn token, and the next publish goes out under the wrong name.
REQUIRE_IDENTITY=false

# ---- Storage ----
# Where tokens, drafts, the audit trail, and images live.
#   local — files under the project directory. The default, and what you want
#           on a developer machine: a draft stays a markdown file you can open.
#   s3    — the same keys as objects in a bucket. Required on Vercel, where the
#           filesystem is read-only and per-instance.
# Deliberately not inferred from the presence of AWS credentials: a store
# holding a token that publishes under your name should be chosen, not guessed.
STORAGE_BACKEND=local

# S3 settings, used only when STORAGE_BACKEND=s3.
# Credentials come from the standard AWS chain — AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, or an instance role. They are never read from here.
S3_BUCKET=
AWS_REGION=ap-south-1
# Optional path prefix, so one bucket can hold more than this app.
S3_PREFIX=linkedin-agent
# For S3-compatible stores (Cloudflare R2, MinIO, Backblaze). Leave unset for AWS.
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# ---- Local web UI ----
# Bound to 127.0.0.1 only. The shared secret is generated on first run and kept
# in .state/ui-token.txt; it is required on every /api call because loopback is
# not a trust boundary in a browser.
UI_PORT=5601

# `npm run ui` opens the URL in your default browser, because it carries the
# token and is not worth copying by hand. Set to false on a headless machine or
# when you are tunnelling the port somewhere else. The URL is printed either way.
UI_OPEN_BROWSER=true

# ---- Deployment (Vercel) ----
# None of this is needed for the local install. Set them as Environment
# Variables in the Vercel project, not here — .env is not uploaded.
#
# How the UI decides who is calling.
#   token — the shared secret printed by `npm run ui`. Correct on a laptop:
#           the server is bound to loopback and only you can read that terminal.
#   oauth — sign in with LinkedIn. A signed cookie carries your member URN and
#           every request runs inside your own workspace.
# Defaults to oauth on Vercel and token everywhere else, so it normally does not
# need setting at all.
# UI_AUTH=oauth
#
# HMAC key for the session cookie. Required when UI_AUTH=oauth. At least 32
# characters, and the SAME value for the life of the deployment — change it and
# everyone is signed out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
#
# Where the app is reachable from outside, no trailing slash. Vercel supplies
# this automatically from the project's production domain; set it only for a
# custom domain, or to develop the deployed mode locally.
#
# APP_URL, not PUBLIC_URL, on Vercel: it refuses to store any variable whose
# name begins with PUBLIC_, because some frameworks expose those to the browser.
# Both names are read, APP_URL first.
# APP_URL=https://postwright.example.com
#
# Whether signing in also asks for the company-page scopes. Off by default:
# asking for a scope the LinkedIn app has not been granted makes LinkedIn reject
# the whole consent screen, so an app still waiting on Community Management API
# approval could not sign anyone in at all. Turn it on once that is approved.
# LINKEDIN_REQUEST_ORG_SCOPES=false

# ---- Draft generation (browser extension only) ----
# Not used by the MCP server: in Claude Code, Claude writes the draft itself.
# Supported: ollama | openai | claude-code
DRAFT_PROVIDER=ollama

# Ollama. Local models need enough free RAM to load (a 4B model wants ~3 GB);
# ":cloud" models run on Ollama's side instead, so they need none.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# OpenAI, or any endpoint speaking the same chat-completions shape.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Headless Claude Code — uses your existing subscription, no API key.
# Requires: npm i -g @anthropic-ai/claude-code
# Leave unset to use the per-platform default (claude.cmd on Windows, claude
# elsewhere). Set it only to point at a specific install path.
# CLAUDE_CODE_BIN=
# Default model alias for drafting: sonnet | opus | fable, or a full model id.
# Leave empty for the CLI's own default. The UI can override it per request.
CLAUDE_CODE_MODEL=

# Carousel (document post) colour scheme: dark | light. A draft can override it.
LINKEDIN_DECK_THEME=dark

# ---- Research (Brave Search) ----
# Powers topic suggestions, grounding facts for a draft, and image search.
# Free tier at https://api-dashboard.search.brave.com — one key covers web and
# image search. Optional: without it those buttons report themselves disabled.
BRAVE_API_KEY=

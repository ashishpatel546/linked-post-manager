# What must never leave this machine.
#
# `vercel deploy` from a terminal uploads the working directory, not a git
# commit — so .gitignore is not what decides this, and every one of these
# directories is either a live credential or your own content. .state/tokens.json
# alone is a 60-day token that publishes under your name.
.env
.env.local
.state/
users/
drafts/
published/
assets/

# Installed on Vercel from package-lock.json, not uploaded.
node_modules/

# Generated by the build on Vercel, from src/http/. A stale local copy would
# quietly win over the fresh one.
public/
.vercel/

# Local-only tooling and notes.
.playwright-mcp/
docs/
start.cmd
*.log

node_modules/
.env
.env.local
*.log

# Runtime state: tokens and the publish audit trail. Never commit either.
.state/
drafts/**/*.published.md
drafts
mcp.json

# Post content and uploads. Same reasoning as drafts/ — this is what you wrote
# and what you published, not source. `users/` is the per-member tree the
# workspace scoping creates, and it holds one access token per member.
published/
assets/
users/

# Browser-automation output from responsive checks.
.playwright-mcp/

# Generated by scripts/build-public.mjs for a Vercel deploy: copies of
# src/http/*, which is the only place they are edited.
public/

# Added by `vercel link`: the project link, and the .env.local it writes with a
# short-lived OIDC token. `.env*` is deliberately narrowed here — it would
# otherwise cover .env.example, which is tracked on purpose and is the only
# documentation of what needs setting.
.vercel/
.env.local
!.env.example
